<?xml version="1.0" encoding="utf-8"?>
<!-- The device key is never backed up or moved to a new device (decision 0080, section 3). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
