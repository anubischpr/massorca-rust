{
  "id": "massorca.codex",
  "name": "Codex",
  "version": "1.0.0",
  "publisher": "massorca",
  "description": "OpenAI's Codex agent, run in your workspaces.",
  "api": "1.0",
  "requires": { "massorca": ">=0.1.0" },
  "surfaces": ["desktop"],
  "modes": ["workspaces"],
  "permissions": [
    { "kind": "process", "scope": { "programs": ["codex"] }, "reason": "Runs the Codex CLI." },
    { "kind": "credentials", "scope": { "agents": ["codex"] }, "reason": "Keeps your Codex sign-ins for its sessions." }
  ],
  "contributes": {
    "agentAdapters": [{
      "id": "codex",
      "kind": "agents/codex.json",
      "cli": {
        "binary": "codex",
        "source": "https://github.com/openai/codex",
        "sourceChecked": "2026-11-22",
        "install": [
          { "os": "windows", "command": ["npm", "install", "-g", "@openai/codex"] },
          { "os": "linux", "command": ["npm", "install", "-g", "@openai/codex"] },
          { "os": "macos", "command": ["npm", "install", "-g", "@openai/codex"] }
        ],
        "uninstall": [
          { "os": "windows", "command": ["npm", "uninstall", "-g", "@openai/codex"] },
          { "os": "linux", "command": ["npm", "uninstall", "-g", "@openai/codex"] },
          { "os": "macos", "command": ["npm", "uninstall", "-g", "@openai/codex"] }
        ]
      }
    }]
  },
  "listing": {
    "category": "agents",
    "developer": { "name": "MassOrca" },
    "mention": "codex",
    "banner": {
      "colors": ["#4B5563", "#9CA3AF"],
      "examples": [
        { "kind": "mention", "text": "@codex", "caption": "@codex fix the failing test" },
        { "kind": "mention", "text": "@codex", "caption": "@codex explain this error and suggest a fix" },
        { "kind": "mention", "text": "@codex", "caption": "@codex refactor this function without changing its behaviour" }
      ]
    },
    "connections": [{ "id": "account", "kind": "agent-login", "title": "Codex account", "multiple": true }]
  }
}
