{
  "id": "massorca.antigravity",
  "name": "Antigravity",
  "version": "1.0.0",
  "publisher": "massorca",
  "description": "Google's Antigravity agent, run in your workspaces.",
  "api": "1.0",
  "requires": { "massorca": ">=0.1.0" },
  "surfaces": ["desktop"],
  "modes": ["workspaces"],
  "permissions": [
    { "kind": "process", "scope": { "programs": ["agy"] }, "reason": "Runs the Antigravity CLI." }
  ],
  "contributes": {
    "agentAdapters": [{
      "id": "antigravity",
      "kind": "agents/antigravity.json",
      "cli": {
        "binary": "agy",
        "verify": ["agy", "--version"],
        "source": "https://antigravity.google/docs/getting-started?tab=cli",
        "sourceChecked": "2026-11-22",
        "install": [
          { "os": "windows", "command": ["powershell", "-NoProfile", "-Command", "irm https://antigravity.google/cli/install.ps1 | iex"] },
          { "os": "linux", "command": ["bash", "-c", "set -o pipefail; curl -fsSL https://antigravity.google/cli/install.sh | bash"] },
          { "os": "macos", "command": ["bash", "-c", "set -o pipefail; curl -fsSL https://antigravity.google/cli/install.sh | bash"] }
        ]
      }
    }]
  },
  "listing": {
    "category": "agents",
    "developer": { "name": "MassOrca" },
    "mention": "antigravity",
    "banner": {
      "colors": ["#4285F4", "#34A853"],
      "examples": [
        { "kind": "mention", "text": "@antigravity", "caption": "@antigravity plan the next change" },
        { "kind": "mention", "text": "@antigravity", "caption": "@antigravity review the open tasks in this workspace" },
        { "kind": "mention", "text": "@antigravity", "caption": "@antigravity summarize what changed on this branch" }
      ]
    }
  }
}
