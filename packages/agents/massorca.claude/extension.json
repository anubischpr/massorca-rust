{
  "id": "massorca.claude",
  "name": "Claude",
  "version": "1.0.0",
  "publisher": "massorca",
  "description": "Anthropic's Claude Code agent, run in your workspaces.",
  "api": "1.0",
  "requires": { "massorca": ">=0.1.0" },
  "surfaces": ["desktop"],
  "modes": ["workspaces"],
  "permissions": [
    { "kind": "process", "scope": { "programs": ["claude"] }, "reason": "Runs the Claude Code CLI." },
    { "kind": "credentials", "scope": { "agents": ["claude"] }, "reason": "Keeps your Claude sign-ins for its sessions." }
  ],
  "contributes": {
    "agentAdapters": [{
      "id": "claude",
      "kind": "agents/claude.json",
      "cli": {
        "binary": "claude",
        "verify": ["claude", "--version"],
        "source": "https://code.claude.com/docs/en/setup",
        "sourceChecked": "2026-11-22",
        "install": [
          { "os": "windows", "command": ["winget", "install", "Anthropic.ClaudeCode"] },
          { "os": "linux", "command": ["npm", "install", "-g", "@anthropic-ai/claude-code@latest"] },
          { "os": "macos", "command": ["brew", "install", "--cask", "claude-code"] }
        ],
        "uninstall": [
          { "os": "windows", "command": ["winget", "uninstall", "Anthropic.ClaudeCode"] },
          { "os": "linux", "command": ["npm", "uninstall", "-g", "@anthropic-ai/claude-code"] },
          { "os": "macos", "command": ["brew", "uninstall", "--cask", "claude-code"] }
        ]
      }
    }]
  },
  "listing": {
    "category": "agents",
    "developer": { "name": "MassOrca" },
    "mention": "claude",
    "banner": {
      "colors": ["#D97757", "#B5532F"],
      "examples": [
        { "kind": "mention", "text": "@claude", "caption": "@claude review the workspace changes and list the risks" },
        { "kind": "mention", "text": "@claude", "caption": "@claude explain how this module works" },
        { "kind": "mention", "text": "@claude", "caption": "@claude write tests for the function I select" }
      ]
    },
    "connections": [{ "id": "account", "kind": "agent-login", "title": "Claude account", "multiple": true }]
  }
}
