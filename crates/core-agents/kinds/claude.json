{
  "id": "claude",
  "name": "Claude",
  "icon": "claude",
  "program": ["claude"],
  "args": [],
  "prompt": { "mode": "argv", "separator": false, "paste": "bracketed", "submit": "\r" },
  "session_ref": { "assign": ["--session-id", "{ref}"], "learn": "session_id" },
  "resume": ["--resume", "{ref}"],
  "status": {
    "mechanism": "claude-settings",
    "events": {
      "SessionStart": "idle",
      "UserPromptSubmit": "working",
      "PreToolUse": "working",
      "Notification": "waiting",
      "Stop": "done"
    }
  },
  "credentials": {
    "home_env": "CLAUDE_CONFIG_DIR",
    "files": [".credentials.json", ".claude.json"],
    "strip_env": ["ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "CLAUDE_CODE_OAUTH_TOKEN"]
  },
  "accounts": {
    "login": ["auth", "login"],
    "check": { "args": ["auth", "status"], "signed_in_exit": 0 },
    "logout": ["auth", "logout"],
    "strip_env": [
      "ANTHROPIC_API_KEY",
      "ANTHROPIC_AUTH_TOKEN",
      "CLAUDE_CODE_OAUTH_TOKEN",
      "CLAUDE_CODE_OAUTH_REFRESH_TOKEN",
      "ANTHROPIC_PROFILE",
      "ANTHROPIC_FEDERATION_RULE_ID",
      "ANTHROPIC_ORGANIZATION_ID",
      "ANTHROPIC_WORKSPACE_ID",
      "ANTHROPIC_IDENTITY_TOKEN_FILE",
      "CLAUDE_CODE_USE_BEDROCK",
      "CLAUDE_CODE_USE_VERTEX",
      "CLAUDE_CODE_USE_FOUNDRY",
      "ANTHROPIC_FOUNDRY_API_KEY",
      "ANTHROPIC_FOUNDRY_AUTH_TOKEN",
      "AWS_BEARER_TOKEN_BEDROCK",
      "ANTHROPIC_AWS_API_KEY",
      "CLAUDE_CODE_CLIENT_CERT",
      "CLAUDE_CODE_CLIENT_KEY",
      "CLAUDE_CODE_CLIENT_KEY_PASSPHRASE"
    ]
  },
  "permission_modes": [
    {
      "id": "default",
      "label": "Manual",
      "description": "Asks before file edits and commands; reads in the working directories run without asking.",
      "args": ["--permission-mode", "default"]
    },
    {
      "id": "acceptEdits",
      "label": "Edit automatically",
      "description": "File edits and common filesystem commands run without asking.",
      "args": ["--permission-mode", "acceptEdits"]
    },
    {
      "id": "plan",
      "label": "Plan",
      "description": "Reads and plans before changing anything.",
      "args": ["--permission-mode", "plan"]
    },
    {
      "id": "auto",
      "label": "Auto",
      "description": "Everything runs, with background safety checks. Where auto mode is not available, Claude Code starts in Manual.",
      "args": ["--permission-mode", "auto"],
      "may_fall_back": true
    },
    {
      "id": "dontAsk",
      "label": "Don't ask",
      "description": "Only pre-approved tools run; anything that would ask is denied.",
      "args": ["--permission-mode", "dontAsk"]
    },
    {
      "id": "bypassPermissions",
      "label": "Bypass permissions",
      "description": "Everything runs without asking. The vendor says: isolated containers and VMs only.",
      "args": ["--permission-mode", "bypassPermissions"],
      "bypass": true
    }
  ],
  "default_permission_mode": "auto",
  "model": { "flag": "--model" },
  "effort": { "flag": "--effort" }
}
