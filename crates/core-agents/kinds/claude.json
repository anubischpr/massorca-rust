{
  "id": "claude",
  "name": "Claude",
  "icon": "claude",
  "program": ["claude"],
  "args": [],
  "prompt": { "mode": "argv", "separator": false, "paste": "bracketed", "submit": "\r" },
  "session_ref": { "assign": ["--session-id", "{ref}"], "learn": "session_id" },
  "resume": ["--resume", "{ref}"],
  "resume_transcript": { "env": "CLAUDE_CONFIG_DIR", "dir": "{home}/.claude", "glob": "projects/*/{ref}.jsonl" },
  "resume_not_found_pattern": "No conversation found with session ID",
  "instructions": {
    "args": ["--append-system-prompt", "{text}"],
    "supported_when": { "args": ["--help"], "contains": "--append-system-prompt" }
  },
  "chat": { "adapter": "claude-stream-json", "min_version": "2.1.258", "max_major": 2 },
  "strip_inherited_env": [
    "CLAUDE_CODE_CHILD_SESSION",
    "CLAUDE_CODE_SESSION_ID",
    "CLAUDE_CODE_BRIDGE_SESSION_ID",
    "CLAUDECODE"
  ],
  "status": {
    "mechanism": "claude-settings",
    "events": {
      "SessionStart": "idle",
      "UserPromptSubmit": "working",
      "PreToolUse": "working",
      "Notification": "waiting",
      "Stop": "done"
    }
  },
  "credentials": {
    "home_env": "CLAUDE_CONFIG_DIR",
    "files": [".credentials.json", ".claude.json"],
    "strip_env": ["ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "CLAUDE_CODE_OAUTH_TOKEN"],
    "optional": [".claude.json"],
    "sources": [
      { "file": ".credentials.json", "env": "CLAUDE_CONFIG_DIR", "dir": "{home}/.claude" },
      { "file": ".claude.json", "env": "CLAUDE_CONFIG_DIR", "dir": "{home}" }
    ],
    "state": {
      "file": ".claude.json",
      "keep": ["oauthAccount", "theme", "mcpServers"],
      "set": { "hasCompletedOnboarding": true },
      "max_source_bytes": 16777216
    }
  },
  "accounts": {
    "login": ["auth", "login"],
    "check": {
      "args": ["auth", "status", "--json"],
      "signed_in_exit": 0,
      "identity_json": ["email", "orgName"],
      "signed_in_json": "loggedIn"
    },
    "logout": ["auth", "logout"],
    "strip_env": [
      "ANTHROPIC_API_KEY",
      "ANTHROPIC_AUTH_TOKEN",
      "CLAUDE_CODE_OAUTH_TOKEN",
      "CLAUDE_CODE_OAUTH_REFRESH_TOKEN",
      "ANTHROPIC_PROFILE",
      "ANTHROPIC_FEDERATION_RULE_ID",
      "ANTHROPIC_ORGANIZATION_ID",
      "ANTHROPIC_WORKSPACE_ID",
      "ANTHROPIC_IDENTITY_TOKEN_FILE",
      "CLAUDE_CODE_USE_BEDROCK",
      "CLAUDE_CODE_USE_VERTEX",
      "CLAUDE_CODE_USE_FOUNDRY",
      "ANTHROPIC_FOUNDRY_API_KEY",
      "ANTHROPIC_FOUNDRY_AUTH_TOKEN",
      "AWS_BEARER_TOKEN_BEDROCK",
      "ANTHROPIC_AWS_API_KEY",
      "CLAUDE_CODE_CLIENT_CERT",
      "CLAUDE_CODE_CLIENT_KEY",
      "CLAUDE_CODE_CLIENT_KEY_PASSPHRASE"
    ]
  },
  "permission_modes": [
    {
      "id": "auto",
      "label": "Auto",
      "description": "Everything runs, with background safety checks. Where auto mode is not available, Claude Code starts in Manual.",
      "args": ["--permission-mode", "auto"],
      "may_fall_back": true,
      "icon": "sparkles",
      "tone": "normal"
    },
    {
      "id": "default",
      "label": "Manual",
      "description": "Asks before file edits and commands; reads in the working directories run without asking.",
      "args": ["--permission-mode", "{value}"],
      "launch_values": ["default", "manual"],
      "icon": "hand",
      "tone": "normal"
    },
    {
      "id": "acceptEdits",
      "label": "Accept edits",
      "description": "File edits and common filesystem commands run without asking.",
      "args": ["--permission-mode", "acceptEdits"],
      "icon": "file-pen",
      "tone": "normal"
    },
    {
      "id": "plan",
      "label": "Plan",
      "description": "Reads and plans before changing anything.",
      "args": ["--permission-mode", "plan"],
      "icon": "map",
      "tone": "normal"
    },
    {
      "id": "bypassPermissions",
      "label": "Bypass permissions",
      "description": "Everything runs without asking. The vendor says: isolated containers and VMs only.",
      "args": ["--permission-mode", "bypassPermissions"],
      "bypass": true,
      "icon": "shield-alert",
      "tone": "warning"
    },
    {
      "id": "dontAsk",
      "label": "Don't ask",
      "description": "Only pre-approved tools run; anything that would ask is denied.",
      "args": ["--permission-mode", "dontAsk"],
      "icon": "ban",
      "tone": "normal",
      "selectable": false
    }
  ],
  "default_permission_mode": "auto",
  "model": {
    "flag": "--model",
    "choices": [
      { "id": "fable", "label": "Fable" },
      { "id": "opus", "label": "Opus", "fast": true },
      { "id": "sonnet", "label": "Sonnet", "default": true },
      { "id": "haiku", "label": "Haiku", "efforts": [] }
    ]
  },
  "effort": {
    "flag": "--effort",
    "levels": [
      { "id": "low", "label": "Low" },
      { "id": "medium", "label": "Medium" },
      { "id": "high", "label": "High" },
      { "id": "xhigh", "label": "Extra high" },
      { "id": "max", "label": "Max" }
    ],
    "default": "high"
  },
  "fast": {
    "settings": { "fastMode": true },
    "settings_flag": "--settings",
    "live": "/fast",
    "toggle": true
  }
}
