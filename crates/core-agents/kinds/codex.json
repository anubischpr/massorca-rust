{
  "id": "codex",
  "name": "Codex",
  "icon": "codex",
  "program": ["codex"],
  "args": [],
  "prompt": { "mode": "argv", "separator": false, "paste": "plain", "submit": "\r" },
  "session_ref": { "learn": "thread-id" },
  "resume": ["resume", "{ref}"],
  "status": {
    "mechanism": "codex-notify",
    "events": { "turn-complete": "done" }
  },
  "credentials": {
    "home_env": "CODEX_HOME",
    "files": ["auth.json", "config.toml"],
    "strip_env": ["OPENAI_API_KEY"]
  },
  "permission_modes": [
    {
      "id": "auto",
      "label": "Auto",
      "description": "The vendor's preset: the workspace-write sandbox, asking for approval when needed.",
      "args": ["--sandbox", "workspace-write", "--ask-for-approval", "on-request"]
    },
    {
      "id": "read-only",
      "label": "Safe read-only browsing",
      "description": "The read-only sandbox, asking for approval when needed.",
      "args": ["--sandbox", "read-only", "--ask-for-approval", "on-request"]
    },
    {
      "id": "read-only-never",
      "label": "Read-only non-interactive (CI)",
      "description": "The read-only sandbox, never asking for approval.",
      "args": ["--sandbox", "read-only", "--ask-for-approval", "never"]
    },
    {
      "id": "auto-review",
      "label": "Auto-review mode",
      "description": "Approval requests go through automatic review, in the workspace-write sandbox.",
      "args": ["--approve-for-me"]
    },
    {
      "id": "full-access",
      "label": "Dangerous full access",
      "description": "No sandbox and no approvals. The vendor says: only inside an externally hardened environment.",
      "args": ["--dangerously-bypass-approvals-and-sandbox"],
      "bypass": true
    }
  ],
  "default_permission_mode": "auto",
  "model": {
    "args": ["-m", "{value}"],
    "choices": [
      { "id": "gpt-5.6-sol", "label": "GPT-5.6 Sol", "efforts": ["minimal", "low", "medium", "high", "xhigh", "max", "ultra"] },
      { "id": "gpt-5.6-terra", "label": "GPT-5.6 Terra", "efforts": ["minimal", "low", "medium", "high", "xhigh", "max", "ultra"] },
      { "id": "gpt-5.6-luna", "label": "GPT-5.6 Luna", "efforts": ["minimal", "low", "medium", "high", "xhigh", "max"] },
      { "id": "gpt-5.5", "label": "GPT-5.5", "efforts": ["minimal", "low", "medium", "high", "xhigh"] },
      { "id": "gpt-5.2-codex", "label": "GPT-5.2 Codex", "efforts": ["minimal", "low", "medium", "high", "xhigh"] }
    ]
  },
  "effort": {
    "args": ["-c", "model_reasoning_effort={value}"],
    "levels": [
      { "id": "minimal", "label": "Minimal" },
      { "id": "low", "label": "Low" },
      { "id": "medium", "label": "Medium" },
      { "id": "high", "label": "High" },
      { "id": "xhigh", "label": "Extra high" },
      { "id": "max", "label": "Max" },
      { "id": "ultra", "label": "Ultra" }
    ],
    "default": "medium"
  }
}
